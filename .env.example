# Copy this file to .env and edit it. .env is git-ignored, so your credentials stay local.

# === Chip ===
IDF_TARGET=esp32s3

# === Serial port (Linux: /dev/ttyACM0 or /dev/ttyUSB0 | Windows: COM4) ===
PORT=/dev/ttyACM0

# === WiFi network the board joins (station mode) ===
# The board prints its IP address at boot. While WIFI_SSID is empty or still the placeholder below, it creates its own
# access point instead (AP_SSID / AP_PASSWORD, captive portal at http://192.168.4.1/ on port 80).
WIFI_SSID=your_wifi_name
WIFI_PASSWORD=your_wifi_password

# === Fallback access point (password needs 8+ characters, empty = open network) ===
AP_SSID=Ethoric-ESP32
AP_PASSWORD=ethoric123

# === HTTP server port (station mode only; the access point always uses 80) ===
HTTP_PORT=8080
